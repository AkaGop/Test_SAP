# 4. Helpers
# ==========================================================================
def norm(s) -> str:
    s = "" if s is None else str(s)
    s = s.replace("\u00a0", " ").strip().lower().rstrip(":").strip()
    return re.sub(r"\s+", " ", s)


def cell_str(v) -> str:
    if v is None:
        return ""
    if isinstance(v, float) and v.is_integer():
        v = int(v)
    if isinstance(v, (dt.date, dt.datetime)):
        return v.strftime("%d.%m.%Y")
    return str(v).strip()


def yes(v) -> bool:
    return norm(v) in {"y", "yes", "j", "ja", "x", "true", "1"}


def to_float(v):
    s = cell_str(v).replace(" ", "")
    if not s:
        return None
    if "," in s and "." in s:
        s = s.replace(".", "").replace(",", ".")
    else:
        s = s.replace(",", ".")
    return float(s)


def sap_num(v, dec_sep: str) -> str:
    f = to_float(v)
    if f is None:
        return ""
    s = str(int(f)) if f.is_integer() else f"{f:.3f}".rstrip("0").rstrip(".")
    return s.replace(".", dec_sep)


def label_match(label: str, targets: list[str]) -> bool:
    nl = norm(label)
    if not nl:
        return False
    for t in targets:
        nt = norm(t)
        if nl == nt or (len(nl) >= 6 and nt.startswith(nl.rstrip("."))):
            return True
    return False


def part_category(v) -> str | None:
    n = norm(v)
    if n.startswith(("new", "neu")):
        return "new"
    if n.startswith(("cons", "verbr")):
        return "consumable"
    return None


def kind_from_id(sid: str) -> str:
    last = sid.rsplit("/", 1)[-1]
    if last.startswith("chk"):
        return "check"
    if last.startswith("cmb"):
        return "combo"
    return "text"


