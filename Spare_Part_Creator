# 5. SAP GUI wrapper
# ==========================================================================
class Sap:
    def __init__(self, session, pause: float = 0.0):
        self.s = session
        self.pause = pause

    def find(self, sid: str):
        try:
            return self.s.findById(sid, False)
        except Exception:
            try:
                return self.s.findById(sid)
            except Exception:
                return None

    def has_popup(self, idx: int = 1) -> bool:
        return self.find(f"wnd[{idx}]") is not None

    def _settle(self):
        if self.pause:
            time.sleep(self.pause)
        for _ in range(400):
            try:
                if not self.s.Busy:
                    return
            except Exception:
                return
            time.sleep(0.05)

    def enter(self, wnd: int = 0):
        self.find(f"wnd[{wnd}]").sendVKey(0)
        self._settle()

    def press(self, element):
        element.press()
        self._settle()

    def press_id(self, sid: str) -> bool:
        el = self.find(sid)
        if el is None:
            return False
        self.press(el)
        return True

    def okcode(self, code: str):
        self.find(ID["okcode"]).text = code
        self.enter(0)

    def status(self) -> tuple[str, str]:
        for sid in ("wnd[1]/sbar", "wnd[0]/sbar"):
            sb = self.find(sid)
            if sb is None:
                continue
            try:
                mtype, text = (sb.MessageType or ""), (sb.Text or "")
            except Exception:
                continue
            if text or sid == "wnd[0]/sbar":
                return mtype, text
        return "", ""

    # ---- discovery (fallback path) ----
    def walk(self, root) -> list:
        out = []
        if root is None:
            return out
        stack = [root]
        while stack:
            node = stack.pop()
            try:
                kids = node.Children
                n = kids.Count
            except Exception:
                continue
            for i in range(n):
                try:
                    k = kids.ElementAt(i)
                    t = k.Type
                except Exception:
                    continue
                out.append(k)
                if t == "GuiTableControl":
                    continue
                try:
                    is_cont = bool(k.ContainerType)
                except Exception:
                    is_cont = False
                if is_cont or t in DESCEND_TYPES:
                    stack.append(k)
        return out

    def screen_index(self, wnd: int = 0) -> "ScreenIndex":
        return ScreenIndex(self.walk(self.find(f"wnd[{wnd}]/usr")))

    def find_button(self, wnd: int, texts: list[str], areas=("tbar[1]", "tbar[0]", "usr")):
        wanted = [norm(t) for t in texts]
        for area in areas:
            for el in self.walk(self.find(f"wnd[{wnd}]/{area}")):
                try:
                    if el.Type != "GuiButton":
                        continue
                    blob = norm(f"{el.Text} | {el.Tooltip}")
                except Exception:
                    continue
                if any(w in blob for w in wanted):
                    return el
        return None

    def table(self, recorded_id: str, wnd: int, cell_names: list[str]):
        """Table by recorded ID, else first table containing all cell names."""
        tbl = self.find(recorded_id) if recorded_id else None
        if tbl is not None:
            return tbl
        for el in self.walk(self.find(f"wnd[{wnd}]/usr")):
            if el.Type != "GuiTableControl":
                continue
            cols = self.table_columns(el)
            if all(any(c.endswith(n) for c in cols) for n in cell_names):
                return el
        return None

    @staticmethod
    def table_columns(tbl) -> list[str]:
        cols = []
        try:
            n = tbl.Columns.Count
        except Exception:
            return cols
        for c in range(n):
            try:
                cols.append(tbl.GetCell(0, c).Name)
            except Exception:
                cols.append("")
        return cols

    def popup_text(self, idx: int = 1) -> str:
        w = self.find(f"wnd[{idx}]")
        parts = []
        try:
            parts.append(w.Text)
        except Exception:
            pass
        for el in self.walk(self.find(f"wnd[{idx}]/usr")):
            if el.Type in ("GuiLabel", "GuiTextField"):
                try:
                    if el.Text.strip():
                        parts.append(el.Text.strip())
                except Exception:
                    pass
        return " | ".join(parts)

    def tab_id(self) -> str:
        """Selected MM01 tab, e.g. 'SP09' (language independent)."""
        ts = self.find("wnd[0]/usr/tabsTABSPR1")
        if ts is None:
            return ""
        tab = None
        try:
            tab = ts.SelectedTab
        except Exception:
            try:
                kids = ts.Children
                for i in range(kids.Count):
                    if kids.ElementAt(i).Children.Count > 0:
                        tab = kids.ElementAt(i)
                        break
            except Exception:
                pass
        if tab is None:
            return ""
        m = re.search(r"tabp([^/]+)$", tab.Id)
        return m.group(1) if m else tab.Name

    def dump(self, out_file: Path):
        lines = []
        for idx in range(0, 4):
            w = self.find(f"wnd[{idx}]")
            if w is None:
                continue
            lines.append(f"===== wnd[{idx}]  title: {w.Text}")
            for el in self.walk(w):
                try:
                    t, name, sid = el.Type, el.Name, el.Id
                except Exception:
                    continue
                text = label = extra = ""
                try:
                    text = el.Text
                except Exception:
                    pass
                try:
                    label = el.LeftLabel.Text
                except Exception:
                    pass
                if t == "GuiTableControl":
                    extra = " columns=" + ",".join(self.table_columns(el))
                elif t == "GuiButton":
                    try:
                        extra = f" tooltip={el.Tooltip!r}"
                    except Exception:
                        pass
                sid = re.sub(r"^/app/con\[\d+\]/ses\[\d+\]/", "", sid)
                lines.append(f"{t:18} name={name:28} label={label!r:30} text={text!r}{extra}\n"
                             f"{'':18} id={sid}")
        out_file.write_text("\n".join(lines), encoding="utf-8")
        return out_file


class ScreenIndex:
    def __init__(self, elements: list):
        self.by_name: dict[str, object] = {}
        self.inputs, self.all = [], elements
        for el in elements:
            try:
                if el.Type in INPUT_TYPES:
                    self.inputs.append(el)
                    self.by_name.setdefault(el.Name, el)
            except Exception:
                pass
        self._labels = None

    @staticmethod
    def _label_of(el) -> str:
        try:
            if el.Type in ("GuiCheckBox", "GuiRadioButton"):
                return el.Text
            return el.LeftLabel.Text
        except Exception:
            return ""

    def lookup(self, spec: FieldSpec):
        for n in spec.names:
            if n in self.by_name:
                return self.by_name[n]
        if not spec.labels:
            return None
        if self._labels is None:
            self._labels = [(self._label_of(el), el) for el in self.inputs]
        for lbl, el in self._labels:
            if label_match(lbl, spec.labels):
                if (spec.kind == "check") != (el.Type == "GuiCheckBox"):
                    continue
                return el
        return None

    def has(self, name: str) -> bool:
        return name in self.by_name

    def get(self, name: str):
        return self.by_name.get(name)

    def shells(self, subtype: str) -> list:
        res = []
        for el in self.all:
            try:
                if el.Type == "GuiShell" and el.SubType == subtype:
                    res.append(el)
            except Exception:
                pass
        return res


def set_value(el, value, kind: str = "text") -> bool:
    """Set a GUI element. Returns True if something changed."""
    try:
        if not el.Changeable:
            return False
    except Exception:
        pass
    t = el.Type
    if t == "GuiCheckBox" or kind == "check":
        want = value if isinstance(value, bool) else yes(value)
        if bool(el.Selected) != want:
            el.Selected = want
            return True
        return False
    if t == "GuiComboBox":
        target = norm(value)
        try:
            if norm(el.Key) == target:
                return False
        except Exception:
            pass
        entries = el.Entries
        for i in range(entries.Count):
            e = entries.ElementAt(i)
            if norm(e.Key) == target or norm(e.Value) == target:
                el.Key = e.Key
                return True
        raise RowError(f"Value '{value}' not found in dropdown '{el.Name}'")
    value = "" if value is None else str(value)
    if el.Text.strip().upper() != value.strip().upper():
        el.Text = value
        return True
    return False


