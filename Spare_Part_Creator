def open_sap_session(d: dict, conn_idx: int = 0, ses_idx: int = 0):
    """Attach to a running SAP GUI, or start SAP Logon, connect and log on."""
    try:
        import win32com.client
    except ImportError:
        sys.exit("pywin32 is missing:  pip install pywin32   (Windows only)")

    def get_gui():
        try:
            return win32com.client.GetObject("SAPGUI")
        except Exception:
            return None

    gui = get_gui()
    if gui is None:
        exe = d.get("sap_logon_path") or r"C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe"
        log.info("Starting SAP Logon: %s", exe)
        try:
            subprocess.Popen([exe])
        except OSError as exc:
            sys.exit(f"Cannot start SAP Logon ({exc}). Set 'sap_logon_path' in the Defaults sheet.")
        for _ in range(60):
            time.sleep(1)
            gui = get_gui()
            if gui is not None:
                break
        else:
            sys.exit("SAP Logon did not start within 60 s")
    app = gui.GetScriptingEngine

    if app.Children.Count == 0:
        system = d.get("sap_system")
        if not system:
            sys.exit("SAP is open but not connected. Enter the system name exactly as shown in "
                     "SAP Logon into 'sap_system' (Defaults sheet), or log on manually first.")
        log.info("Opening connection '%s'", system)
        conn = app.OpenConnection(system, True)
        time.sleep(2)
    else:
        conn = app.Children(conn_idx)
    session = conn.Children(ses_idx)
    sap = Sap(session)

    # logon screen? (not needed with single sign-on)
    if sap.find(ID["logon_user"]) is not None and sap.find(ID["logon_password"]) is not None:
        if d.get("sap_client"):
            sap.find(ID["logon_client"]).text = d["sap_client"]
        if d.get("sap_user"):
            sap.find(ID["logon_user"]).text = d["sap_user"]
        if d.get("sap_language") and sap.find(ID["logon_language"]) is not None:
            sap.find(ID["logon_language"]).text = d["sap_language"]
        pwd = getpass.getpass(f"SAP password for {d.get('sap_user') or 'your user'} (not stored): ")
        sap.find(ID["logon_password"]).text = pwd
        sap.enter(0)
        if sap.find(ID["multi_logon_continue"]) is not None:       # already logged on elsewhere
            sap.find(ID["multi_logon_continue"]).select()
            sap.enter(1)
        mtype, text = sap.status()
        if sap.find(ID["logon_password"]) is not None:
            sys.exit(f"SAP logon failed: {text}")
    try:
        session.findById("wnd[0]").maximize()
    except Exception:
        pass
    info = session.Info
    log.info("Connected: system %s, client %s, user %s", info.SystemName, info.Client, info.User)
    return session


